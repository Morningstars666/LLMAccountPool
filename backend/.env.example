# ===========================================
# 数据库配置
# ===========================================
# 数据库类型：sqlite (默认), postgres, mysql
DB_TYPE=sqlite

# SQLite 数据库文件路径 (仅当 DB_TYPE=sqlite 时使用)
DATABASE_URL=../data/llmaccountpool.db

# PostgreSQL/MySQL 连接配置 (当 DB_TYPE=postgres 或 mysql 时使用)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=llmaccountpool
DB_SSLMODE=disable

# ===========================================
# 连接池配置 (仅用于 PostgreSQL/MySQL)
# ===========================================
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=20
DB_CONN_MAX_LIFETIME=300
DB_CONN_MAX_IDLE_TIME=60

# ===========================================
# SQLite 专用配置 (仅当 DB_TYPE=sqlite 时使用)
# ===========================================
DB_ENABLE_WAL_MODE=true
DB_BUSY_TIMEOUT=5000

# ===========================================
# 服务器配置
# ===========================================
SERVER_PORT=8080
SERVER_HOST=http://localhost:8080

# ===========================================
# 安全配置
# ===========================================
JWT_SECRET=change-this-to-a-secure-secret-key-in-production
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=15

# ===========================================
# 初始用户配置
# ===========================================
# 默认管理员密码（首次启动时使用）
# 如果不设置，将使用默认密码 'admin123'
# 生产环境强烈建议修改此值
DEFAULT_ADMIN_PASSWORD=admin123

# ===========================================
# CORS 配置
# ===========================================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
